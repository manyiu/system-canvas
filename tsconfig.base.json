{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@system-canvas/core": ["./packages/core/src"],
      "@system-canvas/dsl": ["./packages/dsl/src"],
      "@system-canvas/patterns": ["./packages/patterns/src"],
      "@system-canvas/ui": ["./packages/ui/src"]
    }
  }
}
